{
  "name": "myblog",
  "private": true,
  "scripts": {
    "install:ruby": "bundle install",
    "dev": "bundle exec jekyll serve --livereload --host 127.0.0.1",
    "build": "bundle exec jekyll build",
    "clean": "bundle exec jekyll clean",
    "test:e2e": "playwright test",
    "test:unit": "node --test tests/obsidian-publish.test.js tests/obsidian-metadata.test.js",
    "post:publish": "node scripts/obsidian-publish.js --draft",
    "plugin:sync": "powershell -ExecutionPolicy Bypass -File scripts/sync-obsidian-plugin.ps1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1"
  }
}
