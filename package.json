{
  "name": "myblog",
  "private": true,
  "scripts": {
    "install:ruby": "bundle install",
    "dev": "bundle exec jekyll serve --livereload --host 127.0.0.1",
    "build": "bundle exec jekyll build",
    "clean": "bundle exec jekyll clean",
    "test:e2e": "playwright test",
    "test:unit": "node --test tests/obsidian-publish.test.js tests/obsidian-metadata.test.js tests/obsidian-plugin-runtime.test.js tests/cleanup-preview.test.js",
    "post:publish": "node scripts/obsidian-publish.js --draft",
    "preview:clean": "node scripts/cleanup-obsidian-preview.js",
    "plugin:sync": "powershell -ExecutionPolicy Bypass -File scripts/sync-obsidian-plugin.ps1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "mathjax": "^3.2.2"
  }
}
